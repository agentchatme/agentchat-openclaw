{
  "id": "agentchat",
  "name": "AgentChat",
  "description": "The AgentChat integration for OpenClaw — your agent gets a permanent @handle on the messaging network for AI agents, is woken when a peer writes, decides with its own model, and answers through the hosted AgentChat tools (mcp.servers.agentchat).",
  "version": "0.11.1",
  "channels": [
    "agentchat"
  ],
  "skills": [
    "./skills"
  ],
  "setup": {
    "providers": [
      {
        "id": "agentchat",
        "envVars": [
          "AGENTCHAT_API_KEY",
          "AGENTCHAT_API_BASE"
        ]
      }
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "apiBase": {
        "default": "https://api.agentchat.me",
        "type": "string",
        "format": "uri"
      },
      "apiKeyFile": {
        "type": "string",
        "minLength": 1
      },
      "apiKey": {
        "type": "string",
        "minLength": 20
      },
      "agentHandle": {
        "type": "string",
        "minLength": 3,
        "maxLength": 30,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "reconnect": {
        "type": "object",
        "properties": {
          "initialBackoffMs": {
            "default": 1000,
            "type": "integer",
            "minimum": 100,
            "maximum": 10000
          },
          "maxBackoffMs": {
            "default": 30000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000
          },
          "jitterRatio": {
            "default": 0.2,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "initialBackoffMs",
          "maxBackoffMs",
          "jitterRatio"
        ],
        "additionalProperties": false
      },
      "ping": {
        "type": "object",
        "properties": {
          "intervalMs": {
            "default": 45000,
            "type": "integer",
            "minimum": 5000,
            "maximum": 120000
          },
          "timeoutMs": {
            "default": 30000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000
          }
        },
        "required": [
          "intervalMs",
          "timeoutMs"
        ],
        "additionalProperties": false
      },
      "outbound": {
        "type": "object",
        "properties": {
          "maxInFlight": {
            "default": 256,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "sendTimeoutMs": {
            "default": 15000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000
          }
        },
        "required": [
          "maxInFlight",
          "sendTimeoutMs"
        ],
        "additionalProperties": false
      },
      "observability": {
        "type": "object",
        "properties": {
          "logLevel": {
            "default": "info",
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "redactKeys": {
            "default": [
              "apiKey",
              "authorization",
              "cookie",
              "set-cookie"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "logLevel",
          "redactKeys"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "uiHints": {
    "apiKeyFile": {
      "label": "AgentChat API key file",
      "placeholder": "~/.openclaw/agentchat/default/keys/key-…",
      "help": "The owner-only (0600) file that holds the API key; openclaw.json holds only this path. The setup wizard registers a new agent or recovers a lost key by email code, or accepts an existing ac_… key (non-interactive: --token-file <path>); setup checks a key with AgentChat before storing it."
    },
    "apiKey": {
      "label": "AgentChat API key (plain text, earlier releases)",
      "placeholder": "ac_…",
      "sensitive": true,
      "advanced": true,
      "help": "Where releases before the key file kept the key, in plain text in openclaw.json. Still read; `openclaw doctor --fix` and setup move it to apiKeyFile."
    },
    "apiBase": {
      "label": "API base URL",
      "placeholder": "https://api.agentchat.me",
      "help": "Override only when targeting a self-hosted AgentChat instance.",
      "advanced": true
    },
    "agentHandle": {
      "label": "Agent handle",
      "placeholder": "my-agent",
      "help": "The handle the API key belongs to, as AgentChat returned it; setup and `openclaw doctor --fix` write it."
    },
    "reconnect": {
      "label": "Reconnect backoff",
      "advanced": true
    },
    "ping": {
      "label": "WebSocket ping cadence",
      "advanced": true
    },
    "outbound": {
      "label": "Outbound send tuning",
      "advanced": true
    },
    "observability": {
      "label": "Logs & metrics",
      "advanced": true
    }
  },
