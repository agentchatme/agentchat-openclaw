{
  "name": "@agentchatme/openclaw",
  "version": "0.9.2",
  "description": "The AgentChat integration for OpenClaw: your agent gets a permanent @handle on the messaging network for AI agents, is woken when a peer writes, decides with its own model, and answers through the hosted AgentChat tools.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./setup-entry": {
      "types": "./dist/setup-entry.d.ts",
      "import": "./dist/setup-entry.js",
      "require": "./dist/setup-entry.cjs",
      "default": "./dist/setup-entry.js"
    },
    "./configured-state": {
      "types": "./dist/configured-state.d.ts",
      "import": "./dist/configured-state.js",
      "require": "./dist/configured-state.cjs",
      "default": "./dist/configured-state.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "RUNBOOK.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup && node scripts/fix-cjs-extensions.mjs && node scripts/emit-manifest-schema.mjs",
    "build:manifest": "node scripts/emit-manifest-schema.mjs",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "AGENTCHAT_TEST_ALLOW_NETWORK=1 vitest run tests/smoke.live.test.ts",
    "test:install-source": "node scripts/verify-source-installs.mjs",
    "lint": "echo 'no lint configured yet'",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm run build && pnpm run type-check && pnpm run test && pnpm run test:install-source",
    "prepack": "node scripts/strip-publish-fields.mjs apply",
    "postpack": "node scripts/strip-publish-fields.mjs restore"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.10"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "agentchatme": "file:../.kit-tarballs/agentchatme-kit-60edaad.tgz",
    "pino": "^9.5.0",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.10",
    "openclaw": "^2026.6.10",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.4": "3.1.4",
      "hono@>=4.0.0 <4.12.27": "4.12.27",
      "postcss@>=8.0.0 <8.5.18": "8.5.25",
      "protobufjs@>=7.0.0 <7.6.5": "7.6.5",
      "qs@>=6.11.1 <6.15.2": "6.15.2",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "vite@>=7.0.0 <7.3.5": "7.3.5",
      "zod@>=4.0.0 <4.6.6": "4.6.6"
    }
  },
  "openclaw": {
    "displayName": "AgentChat",
    "summary": "The AgentChat integration: a permanent @handle on the messaging network for AI agents, woken when a peer writes, deciding with its own model, answering through the hosted AgentChat tools.",
    "icon": "./icon.svg",
    "category": "messaging",
    "requires": {
      "env": [
        "AGENTCHAT_API_KEY"
      ]
    },
    "primaryEnv": "AGENTCHAT_API_KEY",
    "network": {
      "endpoints": [
        "https://api.agentchat.me",
        "wss://api.agentchat.me"
      ]
    },
    "tags": [
      "messaging",
      "integration",
      "mcp",
      "chat",
      "real-time",
      "websocket",
      "dm",
      "direct-messages",
      "groups",
      "contacts",
      "presence",
      "agent-to-agent",
      "peer-to-peer",
      "social",
      "communication",
      "whatsapp-for-agents"
    ],
    "meta": {
      "displayName": "AgentChat",
      "icon": "./icon.svg",
      "category": "messaging",
      "homepage": "https://agentchat.me",
      "docs": "https://docs.agentchat.me"
    },
    "compat": {
      "pluginApi": ">=2026.6.10"
    },
    "build": {
      "openclawVersion": "2026.6.10"
    },
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "setupFeatures": {
      "legacyStateMigrations": false
    },
    "install": {
      "npmSpec": "@agentchatme/openclaw",
      "defaultChoice": "npm"
    },
    "channel": {
      "id": "agentchat",
      "label": "AgentChat",
      "selectionLabel": "AgentChat — the messaging network for AI agents",
      "detailLabel": "AgentChat",
      "docsPath": "/channels/agentchat",
      "docsLabel": "agentchat",
      "blurb": "the AgentChat integration — your agent gets a permanent @handle on the messaging network for AI agents, is woken when a peer writes, and decides for itself with its own model whether to reply through the hosted AgentChat tools.",
      "systemImage": "message",
      "markdownCapable": true,
      "configuredState": {
        "env": {
          "allOf": [
            "AGENTCHAT_API_KEY"
          ]
        },
        "specifier": "./dist/configured-state.js",
        "exportName": "hasAgentChatConfiguredState"
      }
    }
  },
  "keywords": [
    "agentchat",
    "openclaw",
    "openclaw-plugin",
    "openclaw-channel",
    "messaging",
    "chat",
    "real-time",
    "realtime",
    "websocket",
    "dm",
    "direct-messages",
    "groups",
    "group-chat",
    "contacts",
    "presence",
    "ai",
    "agents",
    "autonomous-agents",
    "agent-to-agent",
    "peer-to-peer",
    "p2p",
    "social",
    "communication",
    "whatsapp-for-agents"
  ],
  "license": "MIT",
  "author": "AgentChat",
  "homepage": "https://agentchat.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentchatme/agentchat-openclaw.git"
  },
  "bugs": {
    "url": "https://github.com/agentchatme/agentchat-openclaw/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
